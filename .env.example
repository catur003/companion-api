# Companion API — konfigurasi lewat environment variable, BUKAN hardcode di kode.
# Copy jadi .env dan isi sesuai VPS Coolify kamu. Jangan commit file .env asli.

# Port Companion API sendiri (beda dari port Coolify/aplikasi lain)
PORT=4100

# Bearer token buat auth request dari ZenVPS app -> Companion API
# (pola sama seperti vps-manager sekarang: Authorization: Bearer <token>)
COMPANION_API_TOKEN=

# Base URL & token API Coolify (buat ambil connection string DB "live" per-request,
# BUKAN disimpan permanen -- lihat src/db/dbBrowser.js)
COOLIFY_API_BASE_URL=
COOLIFY_API_TOKEN=

# Root folder source app DI DALAM container (konvensi Nixpacks: /app).
# Dipakai file manager buat baca/tulis lewat Docker archive API -- lihat src/files/fileManager.js
COMPANION_CONTAINER_APP_ROOT=/app

# Path ke Docker socket di host, buat restart-count fallback (docker inspect read-only)
DOCKER_SOCKET_PATH=/var/run/docker.sock

# Folder log audit trail (setiap command yang di-generate/dikirim wajib tercatat -- Bagian 7 & 9)
AUDIT_LOG_DIR=./logs

# Path file JSON daftar project Coolify (nama, applicationUuid, databaseUuid).
# Default: projects.json di root Companion API. Edit file ini buat nambah
# project baru -- ZenVPS fetch fresh tiap buka Dashboard, TIDAK perlu build
# ulang app mobile. Lihat projects.json.example buat formatnya.
COMPANION_PROJECTS_FILE=
